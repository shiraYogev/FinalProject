<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- צורת פינות אחידה -->
    <style name="App.Shape.M" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- סטייל לכרטיסים (MaterialCardView) -->
    <style name="App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="shapeAppearance">@style/App.Shape.M</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">8dp</item>
        <item name="rippleColor">?attr/colorSecondaryContainer</item>
    </style>

    <!-- טיפוגרפיה כללית (שלך) -->
    <style name="Text.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:alpha">0.8</item>
    </style>

    <style name="Text.Counter" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- טיפוגרפיה ספציפית לכרטיסים -->
    <style name="FP.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="FP.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- צורות עזר -->
    <style name="Shape.Rounded16">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Shape.Rounded12">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- בסיסים "חסיני שגיאה" לשמות ישנים/כלליים -->
    <style name="Shape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlay">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.FP">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- צורות מוגדרות לשימוש ב-MaterialCardView / ShapeableImageView -->
    <style name="ShapeAppearanceOverlay.FP.Rounded16">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.FP.Rounded12">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

</resources>

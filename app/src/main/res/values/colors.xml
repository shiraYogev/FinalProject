    <color name="text_primary_white">#FFFFFF</color>
    <color name="text_secondary_white">#C9A962</color>  <!-- זהב עדין לטקסט משני על כהה -->
    <color name="text_primary_dark">#121212</color>
    <color name="text_secondary_dark">#6B7280</color>


    <color name="primary_blue">@color/brand_accent</color>
    <color name="primary_blue_dark">@color/brand_navy</color>
    <color name="primary_blue_light">@color/brand_accent_20</color>
    <color name="primary_blue_20">@color/brand_accent_20</color>


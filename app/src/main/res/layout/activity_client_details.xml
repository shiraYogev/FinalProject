<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/client_details_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:layoutDirection="rtl">

    <!-- אזור עליון עם גרדיאנט מודרני -->
    <LinearLayout
        android:id="@+id/header_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/modern_gradient_bg"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header מעוצב -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="48dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- מיכל הכותרות - בצד ימין -->
            <LinearLayout
                android:id="@+id/title_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginStart="48dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- אייקון + כותרת (כיתוב בצד ימין) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="end"
                    android:layoutDirection="rtl">

                    <!-- אייקון -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:srcCompat="@drawable/ic_user"
                        app:tint="#E0FFFFFF"/>

                    <!-- נקודה -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/dot_indicator"
                        android:backgroundTint="#80FFFFFF"/>

                    <!-- כותרת - מיושרת לימין -->
                    <TextView
                        android:id="@+id/title_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="פרטי לקוח"
                        android:textColor="@android:color/white"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01"
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:textAlignment="viewEnd"/>
                </LinearLayout>

                <!-- תת כותרת מעוצבת - ימין -->
                <TextView
                    android:id="@+id/subtitle_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="מילוי ועדכון פרטי לקוח "
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.02"
                    android:gravity="end"
                    android:textAlignment="viewEnd"
                    android:layout_gravity="end"/>

                <!-- מחוון התקדמות חזותי -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="end"
                    android:layoutDirection="ltr">

                    <!-- קו 1 – מודגש (משמאל) -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="@android:color/white"
                        android:layout_marginEnd="6dp"/>

                    <!-- קו 2 -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"
                        android:layout_marginEnd="6dp"/>

                    <!-- קו 3 -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"
                        android:layout_marginEnd="6dp"/>

                    <!-- קו 4 -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"
                        android:layout_marginEnd="6dp"/>

                    <!-- קו 5 -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"
                        android:layout_marginEnd="6dp"/>

                    <!-- קו 6 -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"/>

                    <!-- 7 משמאל (ימני ביותר) - בהיר -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"/>
                </LinearLayout>

            </LinearLayout>

            <!-- כפתור חזור מעוצב - בצד שמאל -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/back_button_card"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#26FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_back"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_arrow_back"
                    app:tint="@android:color/white"
                    android:contentDescription="חזור"/>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- כרטיס הטופס המרכזי - מותאם לטאבלט -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/main_content_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="48dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeColor="#E5E7EB"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/header_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="1200dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="40dp">

                <!-- כותרת מחולקת עם קו מפריד - מיושרת לימין -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical|end"
                    android:layout_marginBottom="32dp"
                    android:layoutDirection="rtl">

                    <!-- טקסט הכותרת -->
                    <TextView
                        android:id="@+id/personal_details_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="פרטים אישיים"
                        android:textColor="#1F2937"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.02"
                        android:layout_marginStart="8dp"/>

                    <!-- אייקון -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:tint="@color/primary_blue"/>

                    <!-- קו לכיוון שמאל -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/divider_gradient"/>
                </LinearLayout>

                <!-- שדות טופס - אחד אחרי השני בעמודה אחת -->

                <!-- תעודת זהות -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="מספר תעודת זהות"
                    app:startIconDrawable="@drawable/ic_badge"
                    app:startIconTint="@color/primary_blue"
                    app:boxStrokeColor="@color/primary_blue"
                    app:hintTextColor="@color/primary_blue"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/clientIdEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="9"
                        android:textSize="16sp"
                        android:textColor="#1F2937"
                        android:fontFamily="sans-serif-medium"
                        android:paddingVertical="16dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- שם מלא -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="שם מלא"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/primary_blue"
                    app:boxStrokeColor="@color/primary_blue"
                    app:hintTextColor="@color/primary_blue"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fullNameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textSize="16sp"
                        android:textColor="#1F2937"
                        android:fontFamily="sans-serif-medium"
                        android:paddingVertical="16dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- אימייל -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="כתובת אימייל"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/primary_blue"
                    app:boxStrokeColor="@color/primary_blue"
                    app:hintTextColor="@color/primary_blue"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textSize="16sp"
                        android:textColor="#1F2937"
                        android:fontFamily="sans-serif-medium"
                        android:paddingVertical="16dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- טלפון -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="מספר טלפון"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="@color/primary_blue"
                    app:boxStrokeColor="@color/primary_blue"
                    app:hintTextColor="@color/primary_blue"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phoneNumberEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:textSize="16sp"
                        android:textColor="#1F2937"
                        android:fontFamily="sans-serif-medium"
                        android:paddingVertical="16dp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- כתובת מלאה -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/fullAddressInputLayout"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="40dp"
                    android:hint="כתובת מלאה (לחץ לבחירה אוטומטית)"
                    app:startIconDrawable="@drawable/ic_location"
                    app:startIconTint="@color/primary_blue"
                    app:endIconMode="custom"
                    app:endIconTint="@color/accent_green_light"
                    app:boxStrokeColor="@color/primary_blue"
                    app:hintTextColor="@color/primary_blue"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fullAddressEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions"
                        android:minLines="1"
                        android:maxLines="2"
                        android:textSize="16sp"
                        android:textColor="#1F2937"
                        android:fontFamily="sans-serif-medium"
                        android:paddingVertical="16dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:cursorVisible="false"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- קו מפריד -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/divider_gradient"
                    android:layout_marginBottom="32dp"
                    android:alpha="0.3"/>

                <!-- כפתורים -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <!-- ביטול -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp"
                        android:text="ביטול"
                        android:textColor="#6B7280"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:cornerRadius="16dp"
                        app:strokeColor="#D1D5DB"
                        app:strokeWidth="2dp"
                        app:icon="@drawable/ic_close"
                        app:iconTint="#6B7280"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconSize="22dp"
                        android:elevation="0dp"/>

                    <!-- שמור פרטי לקוח -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveClientButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:layout_weight="1.5"
                        android:layout_marginStart="16dp"
                        android:text="שמור פרטי לקוח"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_save"
                        app:iconTint="@android:color/white"
                        app:iconGravity="textStart"
                        app:iconPadding="12dp"
                        app:iconSize="22dp"
                        android:backgroundTint="@null"
                        android:background="@drawable/bg_main_card_gradient"
                        android:elevation="4dp"
                        android:stateListAnimator="@null"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- אינדיקטור אבטחה -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_marginTop="24dp"
                    android:padding="12dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:srcCompat="@drawable/ic_lock"
                        app:tint="#10B981"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="הפרטים מוצפנים ומאובטחים"
                        android:textColor="#6B7280"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

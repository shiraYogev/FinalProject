<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:padding="16dp"
    tools:context=".activity.newProject.bank.BankDetailsActivity">

    <!-- כותרת המסך -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="פרטי בנק"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!-- כפתור העלאת PDF -->
    <Button
        android:id="@+id/uploadPdfButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="העלה קובץ PDF"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="@id/txtTitle"
        app:layout_constraintEnd_toEndOf="@id/txtTitle"
        />

    <!-- שם הקובץ שנבחר -->
    <TextView
        android:id="@+id/txtFileName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="לא נבחר קובץ"
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:ellipsize="end"
        android:singleLine="true"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/uploadPdfButton"
        app:layout_constraintStart_toStartOf="@id/uploadPdfButton"
        app:layout_constraintEnd_toEndOf="@id/uploadPdfButton" />

    <!-- ProgressBar עבור תהליך ההעלאה -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/txtFileName"
        app:layout_constraintStart_toStartOf="@id/txtFileName"
        app:layout_constraintEnd_toEndOf="@id/txtFileName" />

</androidx.constraintlayout.widget.ConstraintLayout>

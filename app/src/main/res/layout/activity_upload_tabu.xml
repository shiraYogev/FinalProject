<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:background="#F5F7FA">

    <!-- אזור עליון עם גרדיאנט מודרני -->
    <LinearLayout
        android:id="@+id/header_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/modern_gradient_bg"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header מעוצב -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/header_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="48dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <!-- מיכל הכותרות - בצד ימין -->
            <LinearLayout
                android:id="@+id/title_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginStart="48dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <!-- אייקון + כותרת -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="end"
                    android:layoutDirection="rtl">

                    <!-- אייקון -->
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:srcCompat="@drawable/ic_document"
                        app:tint="#E0FFFFFF"/>

                    <!-- נקודה -->
                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/dot_indicator"
                        android:backgroundTint="#80FFFFFF"/>

                    <!-- כותרת ראשית -->
                    <TextView
                        android:id="@+id/title_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="העלאת טאבו"
                        android:textColor="@android:color/white"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.01"
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="8"
                        android:textAlignment="viewEnd"/>
                </LinearLayout>

                <!-- תת כותרת -->
                <TextView
                    android:id="@+id/description_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="העלה תמונה של טאבו הנכס לצורך זיהוי אוטומטי"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.02"
                    android:gravity="end"
                    android:textAlignment="viewEnd"
                    android:layout_gravity="end"/>

                <!-- מחוון התקדמות חזותי -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="end">

                    <!-- קו 1 (מודגש) -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="@android:color/white"/>

                    <!-- קווים 2-7 (בהירים) -->
                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"/>

                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"/>

                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"/>

                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"/>

                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"/>

                    <View
                        android:layout_width="40dp"
                        android:layout_height="3dp"
                        android:background="@drawable/progress_indicator"
                        android:backgroundTint="#4DFFFFFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- כפתור חזור מעוצב - בצד שמאל -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/back_button_card"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#26FFFFFF"
                app:strokeWidth="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_back"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_arrow_back"
                    app:tint="@android:color/white"
                    android:contentDescription="חזור"/>
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- כרטיס תוכן עם אזור העלאת טאבו -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/tabu_upload_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeColor="#E5E7EB"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/header_bg"
        app:layout_constraintBottom_toTopOf="@id/btnSaveAndContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="1200dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- תיאור -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="צלם או העלה תמונה של טאבו הנכס"
                    android:textSize="18sp"
                    android:textColor="#1F2937"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="24dp"
                    android:textAlignment="center"/>

                <!-- אזור התמונה -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/image_container"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="2dp"
                    android:layout_marginBottom="24dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- placeholder כאשר אין תמונה -->
                        <LinearLayout
                            android:id="@+id/placeholder_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="#F9FAFB">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                app:srcCompat="@drawable/ic_document"
                                app:tint="#9CA3AF"
                                android:layout_marginBottom="16dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="לחץ להעלאת טאבו"
                                android:textSize="16sp"
                                android:textColor="#6B7280"
                                android:fontFamily="sans-serif"/>
                        </LinearLayout>

                        <!-- התמונה שהועלתה -->
                        <ImageView
                            android:id="@+id/tabu_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="תמונת טאבו"/>

                        <!-- כפתור מחיקה -->
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btn_delete_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:layout_margin="16dp"
                            app:srcCompat="@drawable/ic_delete"
                            app:tint="@android:color/white"
                            app:backgroundTint="#EF4444"
                            app:elevation="4dp"
                            app:fabSize="mini"
                            android:visibility="gone"
                            android:contentDescription="מחק תמונה"/>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- כפתורים להעלאה -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layoutDirection="rtl">

                    <!-- כפתור גלריה -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_gallery"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="גלריה"
                        android:textSize="16sp"
                        android:layout_marginEnd="8dp"
                        app:icon="@drawable/item_image_thumbnail"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#E5E7EB"
                        app:strokeWidth="1dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>

                    <!-- כפתור מצלמה -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_camera"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="מצלמה"
                        android:textSize="16sp"
                        android:layout_marginStart="8dp"
                        app:icon="@drawable/ic_camera"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#E5E7EB"
                        app:strokeWidth="1dp"
                        style="@style/Widget.Material3.Button.OutlinedButton"/>
                </LinearLayout>

                <!-- סטטוס עיבוד -->
                <TextView
                    android:id="@+id/processing_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#059669"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    android:fontFamily="sans-serif-medium"/>

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- כפתור שמירה והמשך -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveAndContinue"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="שמור והמשך"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@null"
        android:background="@drawable/bg_main_card_gradient"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_save"
        app:iconTint="@android:color/white"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
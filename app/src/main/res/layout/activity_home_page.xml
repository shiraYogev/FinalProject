<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:layoutDirection="rtl">

    <!-- גלילה ראשית -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/home_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========== Header Bar with Gradient (Booking-like) ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/modern_gradient_bg"
                android:paddingBottom="40dp">

                <!-- Top User Bar -->
                <LinearLayout
                    android:id="@+id/user_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="40dp"
                    android:paddingTop="40dp"
                    android:paddingBottom="32dp">

                    <!-- Avatar with Status – בצד ימין -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <androidx.cardview.widget.CardView
                            android:layout_width="68dp"
                            android:layout_height="68dp"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="8dp"
                            app:cardBackgroundColor="@android:color/white">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/user_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:srcCompat="@drawable/icon_smaily"
                                android:contentDescription="@string/cd_user_avatar"
                                android:scaleType="centerCrop"
                                android:background="?attr/selectableItemBackgroundBorderless" />
                        </androidx.cardview.widget.CardView>

                        <!-- Online Status -->
                        <View
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:background="@drawable/dot_indicator" />
                    </FrameLayout>

                    <!-- User Info – ליד האווטאר, בצד ימין -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end"
                        android:layout_marginEnd="16dp">

                        <TextView
                            android:id="@+id/greeting_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:gravity="end"
                            android:letterSpacing="0.05"
                            android:text="שלום"
                            android:textAlignment="viewEnd"
                            android:textColor="#B3FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/user_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="שירה יוגב"
                            android:textColor="@android:color/white"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#99FFFFFF"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif" />
                    </LinearLayout>

                    <!-- Spacer (אמצע ריק, כי אין כפתורים בצד שמאל) -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <!-- לא נשארים כפתורי התראות/הגדרות למעלה -->
                </LinearLayout>

                <!-- ========== Main Stats Cards Row (רק כרטיס אחד) ========== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp">

                    <!-- Total Active Projects -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/main_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="24dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="24dp">

                            <!-- Icon & Title -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <androidx.cardview.widget.CardView
                                    android:layout_width="56dp"
                                    android:layout_height="56dp"
                                    app:cardCornerRadius="18dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="#E3F2FD">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="30dp"
                                        android:layout_height="30dp"
                                        android:layout_gravity="center"
                                        app:srcCompat="@drawable/ic_building"
                                        app:tint="#1976D2"
                                        android:contentDescription="@string/cd_main_card_icon"/>
                                </androidx.cardview.widget.CardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="פרויקטים פעילים"
                                        android:textColor="#424242"
                                        android:textSize="14sp"
                                        android:letterSpacing="0.02"
                                        android:fontFamily="sans-serif-medium"/>

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="סה&quot;כ פרויקטים במערכת"
                                        android:textColor="#9E9E9E"
                                        android:textSize="11sp"
                                        android:layout_marginTop="2dp"
                                        android:fontFamily="sans-serif"/>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Big Counter -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="16dp">

                                <TextView
                                    android:id="@+id/total_projects_display"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="13"
                                    android:textColor="#1A237E"
                                    android:textSize="48sp"
                                    android:fontFamily="sans-serif-light"/>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="16dp"
                                    android:orientation="vertical"
                                    android:gravity="center_vertical">

                                    <androidx.cardview.widget.CardView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        app:cardCornerRadius="8dp"
                                        app:cardElevation="0dp"
                                        app:cardBackgroundColor="#E8F5E9">

                                        <TextView
                                            android:id="@+id/month_change_text"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="↑ 15%"
                                            android:textColor="#2E7D32"
                                            android:textSize="13sp"
                                            android:fontFamily="sans-serif-medium"
                                            android:paddingHorizontal="12dp"
                                            android:paddingVertical="6dp"/>
                                    </androidx.cardview.widget.CardView>


                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="מהחודש שעבר"
                                        android:textColor="#BDBDBD"
                                        android:textSize="10sp"
                                        android:layout_marginTop="6dp"
                                        android:fontFamily="sans-serif"/>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Bottom Info -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:background="#F0F0F0"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="12dp"/>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    app:srcCompat="@drawable/ic_add"
                                    app:tint="#4CAF50"
                                    android:contentDescription="@null"
                                    android:importantForAccessibility="no"/>

                                <TextView
                                    android:id="@+id/completed_this_week"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="3 פרויקטים הושלמו השבוע"
                                    android:textColor="#616161"
                                    android:textSize="13sp"
                                    android:layout_marginStart="8dp"
                                    android:fontFamily="sans-serif-medium"/>

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"/>

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/dot_indicator"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="עודכן לפני רגע"
                                    android:textColor="#9E9E9E"
                                    android:textSize="11sp"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="sans-serif"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- ========== Main Content Area ========== -->

            <!-- Quick Actions -->
            <!-- (לא נגענו פה בכלל) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="פעולות מהירות"
                    android:textColor="#212121"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="20dp"/>
                <LinearLayout
                    android:id="@+id/action_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- New Project -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_new_project"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="160dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:gravity="center_horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#E8EAF6">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:scaleType="centerInside"
                                    app:srcCompat="@drawable/ic_add"
                                    app:tint="#3F51B5"
                                    android:contentDescription="@string/cd_new_project"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="פרויקט חדש"
                                android:textColor="#212121"
                                android:textSize="15sp"
                                android:textAlignment="center"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif-medium"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="צור פרויקט שמאות חדש"
                                android:textColor="#9E9E9E"
                                android:textSize="11sp"
                                android:textAlignment="center"
                                android:gravity="center"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:breakStrategy="balanced"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- My Projects -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_my_projects"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="160dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:gravity="center_horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#F3E5F5">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:scaleType="centerInside"
                                    app:srcCompat="@drawable/ic_folder"
                                    app:tint="#7B1FA2"
                                    android:contentDescription="@string/cd_my_projects"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="הפרויקטים שלי"
                                android:textColor="#212121"
                                android:textSize="15sp"
                                android:textAlignment="center"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif-medium"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="צפה בפרויקטים שלך"
                                android:textColor="#9E9E9E"
                                android:textSize="11sp"
                                android:textAlignment="center"
                                android:gravity="center"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:breakStrategy="balanced"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- All Projects -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_all_projects_view_only"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="160dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:gravity="center_horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#E8F5E9">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:scaleType="centerInside"
                                    app:srcCompat="@drawable/ic_building"
                                    app:tint="#388E3C"
                                    android:contentDescription="@string/cd_all_projects"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="כל הפרויקטים"
                                android:textColor="#212121"
                                android:textSize="15sp"
                                android:textAlignment="center"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif-medium"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="צפייה בכל הפרויקטים"
                                android:textColor="#9E9E9E"
                                android:textSize="11sp"
                                android:textAlignment="center"
                                android:gravity="center"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:breakStrategy="balanced"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Settings (בפעולות מהירות, כן נשאר) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_settings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="160dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardElevation="0dp"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="#E0E0E0"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@android:color/white">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:gravity="center_horizontal">

                            <androidx.cardview.widget.CardView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                app:cardCornerRadius="18dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#FFF3E0">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:scaleType="centerInside"
                                    app:srcCompat="@drawable/ic_settings_gear"
                                    app:tint="#F57C00"
                                    android:contentDescription="@string/cd_settings"/>
                            </androidx.cardview.widget.CardView>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="הגדרות"
                                android:textColor="#212121"
                                android:textSize="15sp"
                                android:textAlignment="center"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif-medium"/>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="ניהול המערכת"
                                android:textColor="#9E9E9E"
                                android:textSize="11sp"
                                android:textAlignment="center"
                                android:gravity="center"
                                android:maxLines="2"
                                android:ellipsize="end"
                                android:breakStrategy="balanced"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- ========== Projects by Status ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="40dp"
                android:layout_marginHorizontal="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/status_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="הפרויקטים שלי לפי סטטוס"
                        android:textColor="#212121"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="צפה בהכל ←"
                        android:textColor="#1976D2"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"/>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/status_projects_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:id="@+id/status_projects_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <!-- Loading State -->
                        <LinearLayout
                            android:id="@+id/status_loading_state"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="48dp">

                            <ProgressBar
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:indeterminateTint="#1976D2"
                                android:layout_marginBottom="16dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="טוען נתונים..."
                                android:textColor="#9E9E9E"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <!-- Dynamic Status List -->
                        <LinearLayout
                            android:id="@+id/status_projects_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ========== Recent Activity / Last Projects ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="40dp"
                android:layout_marginHorizontal="40dp"
                android:layout_marginBottom="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="הפרויקטים האחרונים שלי"
                        android:textColor="#212121"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="היסטוריה מלאה ←"
                        android:textColor="#1976D2"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:padding="8dp"/>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="20dp"
                    app:strokeColor="#E0E0E0"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:id="@+id/recent_activity_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/recent_activity_empty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="טוען פרויקטים אחרונים..."
                            android:textColor="#757575"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif"
                            android:layout_gravity="center_horizontal"
                            android:paddingVertical="16dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

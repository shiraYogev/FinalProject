<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="4dp"
    android:layout_margin="8dp"
    android:background="#FFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:padding="10dp">

        <ImageView
            android:id="@+id/imageThumb"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:scaleType="centerCrop"
            android:background="#CCC"
            android:contentDescription="תמונת הנכס"
            android:layout_gravity="center_vertical" />

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="עוד אפשרויות"
            android:src="@android:drawable/ic_menu_more"
            card_view:tint="#666" />

        <LinearLayout
            android:layout_width="266dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/txtAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="כתובת"
                android:textColor="#333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="הערה אופציונלית"
                android:textColor="#666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="סטטוס"
                android:textColor="#388E3C"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtClient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שם לקוח"
                android:textColor="#666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="תאריך עדכון"
                android:textColor="#999"
                android:textSize="12sp" />

            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:alignItems="center"
                app:flexWrap="wrap"
                app:justifyContent="flex_end">

                <Button
                    android:id="@+id/btnAssignAppraiser"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:drawableStart="@android:drawable/ic_menu_add"
                    android:minWidth="64dp"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="הוסף שמאי"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <Button
                    android:id="@+id/btnMap"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:minWidth="64dp"
                    android:minHeight="48dp"
                    android:text="מפה"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnEdit"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:minWidth="64dp"
                    android:minHeight="48dp"
                    android:text="ערוך"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnImages"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:minWidth="64dp"
                    android:minHeight="48dp"
                    android:text="תמונות"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnReport"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:minWidth="64dp"
                    android:minHeight="48dp"
                    android:text="דו&quot;ח"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnChangeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="4dp"
                    android:minWidth="64dp"
                    android:minHeight="48dp"
                    android:text="שינוי סטטוס"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginBottom="4dp"
                    android:minWidth="64dp"
                    android:minHeight="48dp"
                    android:text="מחיקה"
                    android:textColor="#B71C1C"
                    android:textSize="13sp" />
            </com.google.android.flexbox.FlexboxLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>